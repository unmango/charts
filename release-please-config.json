{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-v-in-tag": false,
  "skip-github-release": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation" },
    { "type": "refactor", "section": "Code Refactoring" },
    { "type": "test", "section": "Tests" },
    { "type": "build", "section": "Build System" },
    { "type": "ci", "section": "Continuous Integration" },
    { "type": "chore", "section": "Miscellaneous Chores", "hidden": true }
  ],
  "packages": {
    "charts/deemix": { "release-type": "helm", "component": "deemix" },
    "charts/filebrowser": { "release-type": "helm", "component": "filebrowser" },
    "charts/hercules-ci-agent": { "release-type": "helm", "component": "hercules-ci-agent" },
    "charts/mage-server": { "release-type": "helm", "component": "mage-server" }
  }
}
