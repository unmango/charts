{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": [
		"auth",
		"cluster",
		"clusterDomain",
		"config",
		"image",
		"persistence",
		"service"
	],
	"properties": {
		"affinity": {
			"type": "object"
		},
		"auth": {
			"type": "object",
			"required": [
				"enabled"
			],
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"existingSecret": {
					"type": "string"
				},
				"existingSecretKey": {
					"type": "string"
				},
				"password": {
					"type": "string"
				}
			}
		},
		"cluster": {
			"type": "object",
			"required": [
				"enabled"
			],
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"nodeTimeout": {
					"type": "integer",
					"minimum": 1
				},
				"replicasPerShard": {
					"type": "integer",
					"minimum": 0
				},
				"shards": {
					"type": "integer",
					"minimum": 3
				}
			}
		},
		"clusterDomain": {
			"type": "string",
			"minLength": 1
		},
		"config": {
			"type": "object",
			"properties": {
				"extra": {
					"type": "string"
				},
				"maxmemory": {
					"type": "string"
				},
				"maxmemoryPolicy": {
					"type": "string"
				}
			}
		},
		"extraEnv": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"name"
				],
				"properties": {
					"name": {
						"type": "string"
					},
					"value": {
						"type": "string"
					},
					"valueFrom": {
						"type": "object"
					}
				}
			}
		},
		"extraVolumeMounts": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"name",
					"mountPath"
				],
				"properties": {
					"mountPath": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"subPath": {
						"type": "string"
					}
				}
			}
		},
		"extraVolumes": {
			"type": "array"
		},
		"global": {
			"type": "object",
			"properties": {
				"imageRegistry": {
					"type": "string"
				}
			}
		},
		"image": {
			"type": "object",
			"properties": {
				"registry": {
					"type": "string"
				},
				"repository": {
					"type": "string"
				},
				"tag": {
					"type": "string"
				},
				"digest": {
					"type": "string"
				}
			}
		},
		"livenessProbe": {
			"type": "object"
		},
		"nodeSelector": {
			"type": "object"
		},
		"persistence": {
			"type": "object",
			"required": [
				"enabled"
			],
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"size": {
					"type": "string"
				},
				"storageClassName": {
					"type": "string"
				},
				"accessModes": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"enum": [
							"ReadWriteOnce",
							"ReadOnlyMany",
							"ReadWriteMany",
							"ReadWriteOncePod"
						]
					}
				}
			}
		},
		"podAntiAffinity": {
			"type": "string",
			"enum": [
				"soft",
				"hard",
				""
			]
		},
		"podDisruptionBudget": {
			"type": "object",
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"maxUnavailable": {
					"type": [
						"string",
						"integer"
					]
				}
			}
		},
		"podSecurityContext": {
			"type": "object"
		},
		"readinessProbe": {
			"type": "object"
		},
		"replicaCount": {
			"type": "integer",
			"minimum": 1
		},
		"resources": {
			"type": "object",
			"properties": {
				"limits": {
					"type": "object",
					"properties": {
						"cpu": {
							"type": [
								"string",
								"number"
							]
						},
						"memory": {
							"type": "string"
						}
					}
				},
				"requests": {
					"type": "object",
					"properties": {
						"cpu": {
							"type": [
								"string",
								"number"
							]
						},
						"memory": {
							"type": "string"
						}
					}
				}
			}
		},
		"securityContext": {
			"type": "object"
		},
		"service": {
			"type": "object",
			"required": [
				"type",
				"port"
			],
			"properties": {
				"clusterIP": {
					"type": "string"
				},
				"loadBalancerIP": {
					"type": "string"
				},
				"port": {
					"type": "integer",
					"minimum": 1,
					"maximum": 55535
				},
				"type": {
					"type": "string",
					"enum": [
						"ClusterIP",
						"NodePort",
						"LoadBalancer"
					]
				}
			}
		},
		"tolerations": {
			"type": "array"
		}
	}
}
