+{{- define "gha-runner-scale-set.nix-volume" -}}
+{{- /*
+  kubernetes-novolume mode renders `volumes: []` and mounts nothing, so a store
+  volume here would only ever go unused.
+*/}}
+{{- if ne (default (dict) .Values.containerMode).type "kubernetes-novolume" }}
+{{- $nix := default (dict) .Values.nix }}
+{{- $name := include "actions-runner.nix.volumeName" $nix }}
+{{- $present := false }}
+{{- range $i, $volume := .Values.template.spec.volumes }}
+  {{- if eq $volume.name $name }}
+    {{- $present = true }}
+  {{- end }}
+{{- end }}
+{{- if not $present }}
+{{- include "actions-runner.nix.volume" $nix }}
+{{- end }}
+{{- end }}
+{{- end }}
