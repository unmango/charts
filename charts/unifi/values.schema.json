{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": [
		"database",
		"image",
		"mongodb",
		"persistence",
		"service"
	],
	"properties": {
		"affinity": {
			"type": "object"
		},
		"database": {
			"type": "object",
			"required": [
				"name",
				"username",
				"port",
				"authSource"
			],
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"username": {
					"type": "string",
					"minLength": 1
				},
				"password": {
					"type": "string"
				},
				"existingSecret": {
					"type": "string"
				},
				"host": {
					"type": "string"
				},
				"port": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535
				},
				"authSource": {
					"type": "string",
					"minLength": 1
				},
				"tls": {
					"type": "boolean"
				}
			}
		},
		"extraEnv": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"name"
				],
				"properties": {
					"name": {
						"type": "string"
					},
					"value": {
						"type": "string"
					},
					"valueFrom": {
						"type": "object"
					}
				}
			}
		},
		"extraVolumeMounts": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"name",
					"mountPath"
				],
				"properties": {
					"mountPath": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"subPath": {
						"type": "string"
					}
				}
			}
		},
		"extraVolumes": {
			"type": "array"
		},
		"global": {
			"type": "object",
			"properties": {
				"imageRegistry": {
					"type": "string"
				}
			}
		},
		"image": {
			"type": "object",
			"properties": {
				"registry": {
					"type": "string"
				},
				"repository": {
					"type": "string"
				},
				"tag": {
					"type": "string"
				},
				"digest": {
					"type": "string"
				}
			}
		},
		"java": {
			"type": "object",
			"properties": {
				"memLimit": {
					"type": [
						"string",
						"integer"
					]
				},
				"memStartup": {
					"type": [
						"string",
						"integer"
					]
				}
			}
		},
		"livenessProbe": {
			"type": "object"
		},
		"mongodb": {
			"type": "object",
			"required": [
				"enabled"
			],
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"image": {
					"type": "object",
					"properties": {
						"registry": {
							"type": "string"
						},
						"repository": {
							"type": "string"
						},
						"tag": {
							"type": "string"
						},
						"digest": {
							"type": "string"
						}
					}
				},
				"rootUsername": {
					"type": "string",
					"minLength": 1
				},
				"rootPassword": {
					"type": "string"
				},
				"persistence": {
					"$ref": "#/$defs/claim"
				},
				"resources": {
					"type": "object",
					"properties": {
						"limits": {
							"type": "object",
							"properties": {
								"cpu": {
									"type": [
										"string",
										"number"
									]
								},
								"memory": {
									"type": "string"
								}
							}
						},
						"requests": {
							"type": "object",
							"properties": {
								"cpu": {
									"type": [
										"string",
										"number"
									]
								},
								"memory": {
									"type": "string"
								}
							}
						}
					}
				},
				"readinessProbe": {
					"type": "object"
				},
				"podSecurityContext": {
					"type": "object"
				},
				"securityContext": {
					"type": "object"
				},
				"nodeSelector": {
					"type": "object"
				},
				"tolerations": {
					"type": "array"
				},
				"affinity": {
					"type": "object"
				},
				"tls": {
					"type": "object",
					"required": [
						"enabled"
					],
					"properties": {
						"enabled": {
							"type": "boolean"
						},
						"existingSecret": {
							"type": "string"
						},
						"key": {
							"type": "string",
							"minLength": 1
						},
						"mode": {
							"type": "string",
							"enum": [
								"allowTLS",
								"preferTLS",
								"requireTLS"
							]
						}
					}
				}
			}
		},
		"nodeSelector": {
			"type": "object"
		},
		"persistence": {
			"$ref": "#/$defs/claim"
		},
		"pgid": {
			"type": "integer",
			"minimum": 0
		},
		"podSecurityContext": {
			"type": "object"
		},
		"puid": {
			"type": "integer",
			"minimum": 0
		},
		"readinessProbe": {
			"type": "object"
		},
		"resources": {
			"type": "object",
			"properties": {
				"limits": {
					"type": "object",
					"properties": {
						"cpu": {
							"type": [
								"string",
								"number"
							]
						},
						"memory": {
							"type": "string"
						}
					}
				},
				"requests": {
					"type": "object",
					"properties": {
						"cpu": {
							"type": [
								"string",
								"number"
							]
						},
						"memory": {
							"type": "string"
						}
					}
				}
			}
		},
		"securityContext": {
			"type": "object"
		},
		"service": {
			"type": "object",
			"required": [
				"type",
				"ports"
			],
			"properties": {
				"type": {
					"type": "string",
					"enum": [
						"ClusterIP",
						"LoadBalancer"
					]
				},
				"annotations": {
					"type": "object"
				},
				"loadBalancerIP": {
					"type": "string"
				},
				"ports": {
					"type": "object",
					"required": [
						"https",
						"inform",
						"stun",
						"discovery"
					],
					"additionalProperties": false,
					"properties": {
						"https": {
							"type": "integer",
							"minimum": 1,
							"maximum": 65535
						},
						"inform": {
							"type": "integer",
							"minimum": 1,
							"maximum": 65535
						},
						"stun": {
							"type": "integer",
							"minimum": 1,
							"maximum": 65535
						},
						"discovery": {
							"type": "integer",
							"minimum": 1,
							"maximum": 65535
						}
					}
				}
			}
		},
		"startupProbe": {
			"type": "object"
		},
		"timezone": {
			"type": "string"
		},
		"tolerations": {
			"type": "array"
		},
		"truststore": {
			"type": "object",
			"required": [
				"key"
			],
			"properties": {
				"existingConfigMap": {
					"type": "string"
				},
				"existingSecret": {
					"type": "string"
				},
				"key": {
					"type": "string",
					"minLength": 1
				},
				"password": {
					"type": "string"
				}
			}
		}
	},
	"$defs": {
		"claim": {
			"type": "object",
			"required": [
				"enabled"
			],
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"size": {
					"type": "string"
				},
				"storageClassName": {
					"type": "string"
				},
				"accessModes": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"enum": [
							"ReadWriteOnce",
							"ReadOnlyMany",
							"ReadWriteMany",
							"ReadWriteOncePod"
						]
					}
				}
			}
		}
	}
}
